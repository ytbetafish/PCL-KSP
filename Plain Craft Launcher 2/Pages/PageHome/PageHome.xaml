<local:MyPageRight x:Class="PCL.Pages.PageHome"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid Margin="25,25,25,10">
            <!-- 预设主页（原版主页的三块卡片） -->
            <StackPanel x:Name="PanPreset">
                <local:MyCard x:Name="CardWelcome" Title="欢迎使用 PCL-KSP" Margin="0,0,0,15">
                    <StackPanel Margin="25,38,23,16">
                        <TextBlock x:Name="LabWelcome" FontSize="19" FontWeight="Light" Text="PCL KSP" />
                        <TextBlock x:Name="LabWelcomeSub" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <TextBlock x:Name="LabWelcomeNotice" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </local:MyCard>
                <local:MyCard x:Name="CardCommunity" Title="社区与支持" Margin="0,0,0,15">
                    <local:MyIconButton x:Name="BtnCommunityClose" SvgIcon="lucide/x" Height="20" Width="20"
                                        Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="BtnCommunityClose_Click" />
                    <StackPanel Margin="25,38,23,16">
                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="本项目的 CKAN 公共索引使用坎喵社区提供的加速镜像（api.kerbcat.cn），此处仅为第三方资源归属说明，与坎喵社区无隶属关系。" />
                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="坎喵社区交流群 758050820（kerbcat.com/p/28）" />
                        <TextBlock FontSize="13.5" TextWrapping="Wrap"
                                   Text="问题反馈：github.com/ytbetafish/PCL-KSP/issues" />
                    </StackPanel>
                </local:MyCard>
                <local:MyCard x:Name="CardLog" Title="更新日志" Margin="0,0,0,15">
                    <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                </local:MyCard>
            </StackPanel>

            <!-- 预设：你知道吗 -->
            <local:MyCard x:Name="CardTrivia" Title="你知道吗" Margin="0,0,0,15" Visibility="Collapsed">
                <local:MyIconButton x:Name="BtnTriviaRefresh" SvgIcon="lucide/refresh-cw" Height="22" Width="22"
                                    Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Click="BtnTriviaRefresh_Click" />
                <TextBlock x:Name="LabTrivia" Margin="25,38,52,18" FontSize="13.5" TextWrapping="Wrap" LineHeight="22" />
            </local:MyCard>

            <!-- 联网预设加载中等 -->
            <local:MyCard x:Name="CardPresetLoading" Title="正在加载主页" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock x:Name="LabPresetLoading" FontSize="13" TextWrapping="Wrap" />
                    <local:MyLoading x:Name="LoadPresetLoading" Margin="4,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </local:MyCard>

            <!-- 预设：KSP Wiki 随机条目（多卡片 + 配图，版式对标原版新闻主页） -->
            <StackPanel x:Name="PanWiki" Visibility="Collapsed">
                <!-- 主条目：大横幅图 + 标题胶囊 + 正文 -->
                <local:MyCard x:Name="CardWikiHero" Title="随机条目" Margin="0,0,0,15">
                    <StackPanel Margin="0,38,0,0">
                        <Grid x:Name="PanWikiHeroImage" MaxHeight="230" Margin="20,0,20,0">
                            <Border CornerRadius="4" Background="{DynamicResource ColorBrushSemiTransparent}" />
                            <Image x:Name="ImgWikiHeroPlaceholder" Stretch="Uniform" MaxHeight="230" Visibility="Collapsed" ImageFailed="WikiPlaceholder_ImageFailed"
                                   Source="pack://application:,,,/images/Icons/NoIcon.png" />
                            <Border x:Name="BorWikiHeroTag" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="14" Padding="12,4" CornerRadius="13" Background="#B3000000">
                                <TextBlock x:Name="LabWikiHeroTag" FontSize="12.5" Foreground="White" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="LabWikiTitle" Margin="24,14,20,0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="LabWikiText" Margin="24,8,20,0" FontSize="13" TextWrapping="Wrap" LineHeight="21" />
                        <StackPanel Orientation="Horizontal" Margin="20,16,20,18">
                            <local:MyButton x:Name="BtnWikiOpen" MinWidth="150" Height="28" Padding="13,0" Text="在 Wiki 上打开" Click="BtnWikiOpen_Click" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardWikiBanner" Title="KSP Wiki 随机条目" Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonUp="CardWikiBanner_Click">
                    <Grid Margin="22,38,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Margin="0,0,16,0"
                                VerticalAlignment="Center" Background="{DynamicResource ColorBrushSemiTransparent}">
                            <local:MyIconButton x:Name="BtnWikiNext" SvgIcon="lucide/refresh-cw" Height="24" Width="24"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="换一条" Click="BtnWikiNext_Click" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LabWikiBanner" FontSize="17" FontWeight="Light" Text="每日一个 KSP Wiki 条目" />
                            <TextBlock FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="从 Wiki 的中文条目里随机抽取，抽过的不再重复，抽完一轮会自动重新洗牌。" />
                            <TextBlock x:Name="LabWikiStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </local:MyCard>
            </StackPanel>
            <!-- 本地文件主页 -->
            <ContentControl x:Name="PanCustomHost" Visibility="Collapsed" />

            <!-- 加载失败提示 -->
            <local:MyCard x:Name="CardCustomError" Title="主页加载失败" Margin="0,0,0,15" Visibility="Collapsed">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock x:Name="LabCustomError" TextWrapping="Wrap" FontSize="13" />
                    <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="可在「设置 → 个性化 → 主页」里改为预设主页或空白主页。" />
                    <local:MyButton x:Name="BtnPresetRetry" MinWidth="110" Height="28" Margin="0,12,0,0"
                                    HorizontalAlignment="Left" Text="重新加载"
                                    Visibility="Collapsed" Click="BtnPresetRetry_Click" />                </StackPanel>
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>