<local:MyPageRight x:Class="PCL.Pages.PageMisc"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="系统">
                <StackPanel Margin="25,37,25,15">
                    <StackPanel Orientation="Vertical">
                        <local:MyCheckBox x:Name="CheckHwAccel" Text="禁用硬件加速" Height="28"
                                           Change="CheckHwAccel_Change" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="网络">
                <StackPanel Margin="25,37,25,15">
                    <local:MyCheckBox x:Name="CheckDoH" Text="启用 DoH（DNS 加密）" Height="28"
                                      Change="CheckDoH_Change" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="调试" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="动画速度" />
                        <local:MySlider Grid.Row="0" Grid.Column="1" x:Name="SliderAnim" MaxValue="30"
                                        Change="SliderAnim_Change" />
                        <local:MyCheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="CheckDebugMode" Text="调试模式"
                                          Change="CheckDebugMode_Change" />
                        <local:MyCheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="CheckDebugDelay" Text="模拟随机延迟"
                                          Change="CheckDebugDelay_Change" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
