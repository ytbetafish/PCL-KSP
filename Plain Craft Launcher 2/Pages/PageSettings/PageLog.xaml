<local:MyPageRight x:Class="PCL.Pages.PageLog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="日志操作">
                <StackPanel Margin="25,37,25,15">
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnExportCurrent" Text="导出当前日志" Width="120" Height="34"
                                         Click="BtnExportCurrent_Click" />
                        <local:MyButton x:Name="BtnExportAll" Text="导出全部日志" Width="120" Height="34" Margin="12,0,0,0"
                                        Click="BtnExportAll_Click" />
                        <local:MyButton x:Name="BtnOpenDir" Text="打开日志目录" Width="120" Height="34" Margin="12,0,0,0"
                                        Click="BtnOpenDir_Click" />
                        <local:MyButton x:Name="BtnClean" Text="清理历史日志" Width="120" Height="34" Margin="12,0,0,0"
                                        ColorType="Red" Click="BtnClean_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="日志文件">
                <StackPanel Margin="25,37,25,15">
                    <StackPanel x:Name="PanList" Orientation="Vertical" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
