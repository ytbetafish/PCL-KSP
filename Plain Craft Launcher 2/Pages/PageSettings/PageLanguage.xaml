<local:MyPageRight x:Class="PCL.Pages.PageLanguage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="界面语言">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="界面语言" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="CboUiLanguage" Height="34"
                                          SelectionChanged="CboUiLanguage_SelectionChanged" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="日期与时间格式" />
                        <local:MyComboBox Grid.Row="2" Grid.Column="1" x:Name="CboFormatCulture" Height="34"
                                          SelectionChanged="CboFormatCulture_SelectionChanged" />
                    </Grid>
                    <TextBlock Margin="0,18,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="切换语言后立即生效；格式文化用于日期、时间与数字的显示方式。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
