<local:MyPageRight x:Class="PCL.Pages.PageTranslate"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="翻译服务">
                <StackPanel Margin="25,37,25,15">
                    <TextBlock Text="使用内置免费接口（腾讯交互翻译，失败自动回退 MyMemory），无需注册、无需 API 密钥。待翻译的模组简介会发送给这些第三方服务；介意的话请勿使用翻译按钮。"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <local:MyButton Text="测试翻译" Height="34" Width="100" Click="BtnTest_Click" />
                    </StackPanel>
                    <TextBlock x:Name="LabTestResult" Text="" Margin="0,10,0,0" FontSize="12"
                               TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="网络设置">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="HTTP 代理" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TxtProxy" Height="34" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <local:MyButton Text="保存" Height="34" Width="100" Click="BtnSave_Click" />
                        <TextBlock x:Name="LabSaved" Text="" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#4CAF50" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
