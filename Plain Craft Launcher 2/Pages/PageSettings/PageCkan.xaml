<local:MyPageRight x:Class="PCL.Pages.PageCkan"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="CKAN 数据目录">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="68" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="数据目录" />
                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="LabCkanDataDir" Height="34" LostFocus="SaveDataDir" />
                            <local:MyButton Grid.Column="1" Text="浏览" Margin="10,0,0,0" Height="34" Width="80" Click="BtnPickCkanDir_Click" />
                        </Grid>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="镜像源" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtMirrorUrls" Height="68" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="0,5" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="模组索引操作">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="仓库策略" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="CboStrategy" Height="34">
                            <ComboBoxItem Content="官方源优先" Tag="OfficialFirst" />
                            <ComboBoxItem Content="镜像源优先" Tag="MirrorFirst" />
                            <ComboBoxItem Content="仅官方源" Tag="OfficialOnly" />
                            <ComboBoxItem Content="仅镜像源" Tag="MirrorOnly" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="稳定性容忍度" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyRadioButton x:Name="OptStable" Text="稳定版" Checked="True" Margin="0,0,20,0" />
                            <local:MyRadioButton x:Name="OptTesting" Text="测试版" Margin="0,0,20,0" />
                            <local:MyRadioButton x:Name="OptPre" Text="预发布版" />
                        </StackPanel>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,25,0" Text="状态" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LabCkanStatus" Text="就绪。" VerticalAlignment="Center" FontSize="13" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <local:MyButton x:Name="BtnRefreshRepo" Text="刷新模组索引" Height="34" Width="120" Click="BtnRefreshRepo_Click" />
                        <local:MyButton Text="导出清单" Height="34" Width="100" Margin="10,0,0,0" Click="BtnExportMods_Click" />
                        <local:MyButton Text="导入清单" Height="34" Width="100" Margin="10,0,0,0" Click="BtnImportMods_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="GitHub 下载加速">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="下载加速" />
                        <local:MyCheckBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ChkGitHubAccel"
                                          Text="对 github.com 的下载链接套用公共镜像"
                                          VerticalAlignment="Center" Change="ChkGitHubAccel_Change" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="加速前缀" />
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="CboGitHubPrefix" Height="34" SelectionChanged="CboGitHubPrefix_SelectionChanged">
                                <ComboBoxItem Content="ghfast.top" Tag="https://ghfast.top/" />
                                <ComboBoxItem Content="gh-proxy.com" Tag="https://gh-proxy.com/" />
                                <ComboBoxItem Content="ghproxy.net" Tag="https://ghproxy.net/" />
                                <ComboBoxItem Content="自定义" Tag="" />
                            </local:MyComboBox>
                            <local:MyTextBox Grid.Column="1" x:Name="TxtGitHubPrefix" Height="34" Margin="10,0,0,0"
                                             LostFocus="TxtGitHubPrefix_LostFocus" />
                        </Grid>
                    </Grid>
                    <local:MyHint Margin="0,14,0,0" Theme="Blue"
                                  Text="加速前缀由第三方公开服务提供，与坎喵的 CKAN 镜像无关；只对 github.com 的下载链接生效，下载失败会自动回退到原地址重试一次。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>




