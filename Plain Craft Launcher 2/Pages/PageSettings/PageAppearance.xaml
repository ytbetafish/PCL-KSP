<local:MyPageRight x:Class="PCL.Pages.PageAppearance"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="主题">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="明暗模式" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="CboColorMode" Height="34"
                                          SelectionChanged="CboColorMode_SelectionChanged">
                            <local:MyComboBoxItem Content="跟随系统" Tag="2" />
                            <local:MyComboBoxItem Content="浅色" Tag="0" />
                            <local:MyComboBoxItem Content="深色" Tag="1" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,25,0" Text="主题色" />
                        <local:MyComboBox Grid.Row="2" Grid.Column="1" x:Name="CboColorTheme" Height="34"
                                          SelectionChanged="CboColorTheme_SelectionChanged">
                            <local:MyComboBoxItem Content="天蓝" Tag="0" />
                            <local:MyComboBoxItem Content="猫咪蓝" Tag="1" />
                            <local:MyComboBoxItem Content="死亡蓝" Tag="2" />
                            <local:MyComboBoxItem Content="HMCL 蓝" Tag="3" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="窗口外观">
                <StackPanel Margin="25,37,25,15">
                    <Grid IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,25,0" Text="窗口透明度" />
                        <local:MySlider Grid.Row="0" Grid.Column="1" x:Name="SliderOpacity" MaxValue="1000"
                                        Change="SliderOpacity_Change" />
                        <local:MyCheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="CheckBlur" Text="启用毛玻璃模糊"
                                          Change="CheckBlur_Change" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="0,0,25,0" Text="模糊半径" />
                        <local:MySlider Grid.Row="4" Grid.Column="1" x:Name="SliderBlurRadius" MaxValue="32"
                                        Change="SliderBlurRadius_Change" />
                    </Grid>
                    <TextBlock Margin="0,18,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="主题与窗口外观修改后实时生效。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15" Title="主页">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox x:Name="RadioHomeBlank" Grid.Column="0" Height="22" Text="空白"
                                          Tag="0" Check="HomeMode_Check" />
                        <local:MyRadioBox x:Name="RadioHomePreset" Grid.Column="1" Height="22" Text="预设"
                                          Tag="1" Check="HomeMode_Check" />
                        <local:MyRadioBox x:Name="RadioHomeLocal" Grid.Column="2" Height="22" Text="本地文件"
                                          Tag="2" Check="HomeMode_Check" />
                    </Grid>
                    <Grid x:Name="PanHomeLocal" Margin="0,14,0,0" Height="34" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,15,0" Text="主页文件" />
                        <local:MyTextBox x:Name="TextHomeFile" Grid.Column="1" Height="34" />
                        <local:MyButton x:Name="BtnHomeBrowse" Grid.Column="2" Height="34" Margin="10,0,0,0"
                                        MinWidth="90" Padding="13,0" Text="浏览…" Click="BtnHomeBrowse_Click" />
                    </Grid>
                    <TextBlock Margin="0,16,0,0" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                               Text="预设为内置主页（公告、社区与更新日志）；空白不显示任何内容；本地文件会加载所选 XAML 文件作为主页内容。设置后返回主页生效。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
