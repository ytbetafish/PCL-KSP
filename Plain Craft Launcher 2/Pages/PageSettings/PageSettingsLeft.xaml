<local:MyPageLeft x:Class="PCL.PageSettingsLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="184"
                  AnimatedControl="{Binding ElementName=PanItem, Mode=OneWay}">
    <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ScrollViewerFullMargin}">
        <StackPanel Margin="0,12,0,0" x:Name="PanItem">
            <TextBlock Text="游戏" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="NavInstance" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="KSP 实例" SvgIcon="lucide/folder-open" />

            <TextBlock Text="模组" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="NavCkan" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="CKAN 模组源" SvgIcon="lucide/package" />

            <TextBlock Text="界面" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="NavTranslate" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="翻译服务" SvgIcon="lucide/globe" />
            <local:MyListItem x:Name="NavLanguage" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="语言与格式" SvgIcon="lucide/globe" />
            <local:MyListItem x:Name="NavAppearance" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="主题外观" SvgIcon="lucide/palette" />
            <local:MyListItem x:Name="NavMisc" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="杂项与调试" SvgIcon="lucide/settings" />

            <TextBlock Text="关于" Margin="13,6,5,4" Opacity="0.6" FontSize="12" />
            <local:MyListItem x:Name="NavLog" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="日志" SvgIcon="lucide/file-text" />
            <local:MyListItem x:Name="NavAbout" IsScaleAnimationEnabled="False" Type="RadioBox"
                              MinPaddingRight="35" Height="36" VerticalAlignment="Top"
                              Title="软件信息" SvgIcon="lucide/info" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>
