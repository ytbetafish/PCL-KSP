<local:MyPageLeft x:Class="PCL.PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  Width="300">
    <!-- 常态：实例信息 + 启动按钮 -->
    <Grid x:Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!-- 顶部：KSP 版本 + 路径 + 启动器版本 -->
        <StackPanel Grid.Row="0" Margin="20,20,20,0">
            <TextBlock x:Name="LabKspVersion" Text="KSP" FontSize="18" Opacity="0.9" />
            <TextBlock x:Name="LabKspPath" Text="" FontSize="12" Opacity="0.6"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="LabLauncherVersion" Text="" FontSize="12" Opacity="0.6"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- 大启动按钮 + 浮在底部的版本号（与原版一致） -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <local:MyButton x:Name="BtnLaunch" Height="54"
                            Text="启动 KSP" ColorType="Highlight"
                            Padding="30,0,30,15" Click="BtnLaunch_Click" />
            <TextBlock x:Name="LabVersion" Margin="35,0,35,10" IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       FontSize="11" Foreground="{DynamicResource ColorBrushGray3}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 两个小按钮均分宽度（与原版一致） -->
        <Grid Grid.Row="3" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnInstance" Height="35" HorizontalAlignment="Stretch"
                            Text="选择实例" Click="BtnSelectInstance_Click" />
            <local:MyButton x:Name="BtnMore" Grid.Column="2" Height="35" HorizontalAlignment="Stretch"
                            Text="实例设置" Click="BtnGotoSettings_Click" />
        </Grid>
    </Grid>

    <!-- 启动中视图（复刻原版 PageLaunching） -->
    <Grid x:Name="PanLaunching" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ScaleLaunching" ScaleX="0.9" ScaleY="0.9" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Margin="0,-7,0,0">
            <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="50" Margin="0,10,0,5" />
            <TextBlock x:Name="LabLaunchingTitle" Margin="15,10,15,0" Text="正在启动 Kerbal Space Program"
                       HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ColorBrush3}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5"
                       HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush3}"
                       TextTrimming="CharacterEllipsis" />

            <!-- 进度条 -->
            <Grid Height="4" Margin="30,12,30,27" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ProgressLaunchingFinished" Width="0*" />
                    <ColumnDefinition x:Name="ProgressLaunchingUnfinished" Width="100*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0" />
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0.6" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6"
                           RadiusX="2" RadiusY="2" />
            </Grid>

            <!-- 阶段 / 进度 / 实例 -->
            <Grid x:Name="PanLaunchingInfo" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12.5" Margin="0,0,0,5"
                           HorizontalAlignment="Right" Opacity="0.5" Text="当前阶段" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LabLaunchingStage" FontSize="12.5"
                           Margin="0,0,0,5" HorizontalAlignment="Left" Text="准备启动" />
                <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12.5" Margin="0,0,0,5"
                           HorizontalAlignment="Right" Opacity="0.5" Text="启动进度" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="LabLaunchingProgress" FontSize="12.5"
                           Margin="0,0,0,5" HorizontalAlignment="Left" Text="0%" />
                <TextBlock Grid.Row="2" Grid.Column="0" FontSize="12.5" Margin="0,0,0,5"
                           HorizontalAlignment="Right" Opacity="0.5" Text="实例" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="LabLaunchingInstance" FontSize="12.5"
                           Margin="0,0,0,5" HorizontalAlignment="Left" MaxWidth="160"
                           TextWrapping="WrapWithOverflow" Text="--" />
            </Grid>

            <!-- 小贴士（复刻原版 PanLaunchingHint 的缺口边框） -->
            <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Width="260" Margin="0,16,0,2">
                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3"
                        BorderBrush="{DynamicResource ColorBrushGray1}" Opacity="0.5">
                    <Border.Clip>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <RectangleGeometry Rect="0,0,1000,1000" />
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <RectangleGeometry Rect="94,0,72,10" />
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Border.Clip>
                </Border>
                <TextBlock FontSize="12.5" Text="小贴士" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Opacity="0.5" />
                <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Margin="11,21,11,10"
                           TextWrapping="Wrap" HorizontalAlignment="Center" MaxHeight="54"
                           TextTrimming="CharacterEllipsis" Text="正在准备游戏进程…" />
            </Grid>
        </StackPanel>

        <local:MyButton Grid.Row="3" x:Name="BtnLaunchCancel" Height="35" Margin="20,0,20,20"
                        VerticalAlignment="Bottom" Text="取消启动" Click="BtnLaunchCancel_Click" />
    </Grid>
</local:MyPageLeft>
